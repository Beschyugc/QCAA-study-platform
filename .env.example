# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project Settings -> Database -> Connection string
# DATABASE_URL: "Transaction" pooler (port 6543, pgbouncer) — used at runtime
# DIRECT_URL: "Session" pooler or direct connection (port 5432) — used by `prisma migrate`
DATABASE_URL=
DIRECT_URL=

# AI tutor — primary provider is Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Secondary: Google Gemini (aistudio.google.com -> Get API key). Tried if
# ANTHROPIC_API_KEY isn't set, or Anthropic rate-limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tertiary fallback when both of the above rate-limit
FALLBACK_AI_PROVIDER=          # "groq" | "openrouter" | "none"
FALLBACK_AI_KEY=

# Nightly backup cron (§16 "never lose data") — Vercel sends this exact
# secret as a Bearer token when it triggers /api/cron/backup. Generate any
# random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# App
APP_ALLOWED_EMAIL=
