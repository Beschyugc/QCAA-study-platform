# Copy this file to .env.local and fill in the blanks.
# .env.local is gitignored — never commit real secrets.
#
# This is a local-only build: no Supabase, no Vercel, no cloud database.
# Everything lives on this machine, inside this folder.

# SQLite file, relative to app/. Leave as-is unless you have a reason to
# move it. Put the whole `app` folder in a Drive/OneDrive-synced folder and
# this travels with it — that's cross-device access without a cloud backend
# (don't run the app from two machines against the synced file at once).
DATABASE_URL="file:./prisma/dev.db"

# Signs the local session cookie — generate one per machine, then leave it
# alone (rotating it logs you out everywhere).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=

# AI tutor — primary provider is Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Secondary: Google Gemini (aistudio.google.com -> Get API key). Tried if
# ANTHROPIC_API_KEY isn't set, or Anthropic rate-limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tertiary fallback when both of the above rate-limit
FALLBACK_AI_PROVIDER=          # "groq" | "openrouter" | "none"
FALLBACK_AI_KEY=
