# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project Settings -> Database -> Connection string
# DATABASE_URL: "Transaction" pooler (port 6543, pgbouncer) — used at runtime
# DIRECT_URL: "Session" pooler or direct connection (port 5432) — used by `prisma migrate`
DATABASE_URL=
DIRECT_URL=

# AI tutor — Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback provider when Gemini rate-limits
FALLBACK_AI_PROVIDER=          # "groq" | "openrouter" | "none"
FALLBACK_AI_KEY=

# Google Calendar (OAuth 2.0 — set up in phase 10)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# App
APP_ALLOWED_EMAIL=
