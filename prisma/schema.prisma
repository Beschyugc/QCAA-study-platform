generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- enums ----------

enum UnlockState {
  locked
  active
  mastered
}

enum RagStatus {
  red
  amber
  green
  unrated
}

enum CardType {
  basic
  basic_reversed
  cloze
  image_occlusion
  formula
  type_in
}

// QCAA's own degree-of-difficulty categories, used verbatim in the syllabuses
// and in the external assessment specifications. Kept as the exam's three
// bands rather than an invented easy/medium/hard scale so a deck can be
// checked against the real paper's mix.
//
// Nullable on Card on purpose: cards written before this existed, and the
// imported Anki deck, were not authored against a band. Stamping them all
// simple_familiar would invent data — the same reason past-paper mark totals
// are left unset rather than guessed.
enum ComplexityBand {
  simple_familiar
  complex_familiar
  complex_unfamiliar
}

enum MediaPosition {
  front
  back
}

/// Why a mark was lost.
///
/// The distinction that matters is knowledge_gap vs everything else: a
/// knowledge gap is fixed by learning content, and the rest are fixed by
/// changing how you work. A student who logs every error as "knowledge gap"
/// will re-read notes forever while the real leak is misreading questions.
enum MistakeCategory {
  knowledge_gap
  conceptual_misunderstanding
  incorrect_method
  calculation_error
  formula_forgotten
  misread_question
  insufficient_working
  time_management
  other
}

/// How far a mistake has been repaired. Advanced by review, never by time.
enum MistakeStatus {
  new
  reviewing
  improving
  mastered
}

enum SrsState {
  new
  learning
  review
  relearning
  leech
}

enum SessionType {
  in_school
  after_school
  weekend
}

enum DocType {
  syllabus
  notes
  past_paper
  marking_guide
}

enum NotesFormat {
  pdf
  pptx
  docx
  other
}

enum PaperConditions {
  timed
  open
  untimed
}

enum ErrorCategory {
  conceptual_gap
  calculation_error
  misread_question
  ran_out_of_time
  poor_communication
}

enum AiMode {
  ask
  hint
  teach_back
  study_coach
  marking_assistant
}

enum AiRole {
  user
  assistant
  system
}

// ---------- curriculum ----------

model Subject {
  id            String   @id @default(uuid())
  userId        String
  name          String
  shortCode     String
  priorityWeight Float
  colour        String
  isActive      Boolean  @default(true)
  targetCompletionDate DateTime?
  nextAssessmentDate   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  units             Unit[]
  cards             Card[]
  studySessions     StudySession[]
  formulaEntries    FormulaEntry[]
  assumedKnowledge  AssumedKnowledge[]
  documents         Document[]
  pastPapers        PastPaper[]
  aiConversations   AiConversation[]
  timetableBlocks   TimetableBlock[]
  calendarEvents    CalendarEvent[]
  dailyQuestionSets DailyQuestionSet[]
  mistakes          Mistake[]

  @@unique([userId, shortCode])
  @@index([userId])
}

model Unit {
  id        String   @id @default(uuid())
  userId    String
  subjectId String
  number    Int
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@index([userId])
  @@index([subjectId])
}

model Topic {
  id           String      @id @default(uuid())
  userId       String
  unitId       String
  number       Int
  title        String
  order        Int
  unlockState  UnlockState @default(locked)
  needsReview  Boolean     @default(false)
  unlockedAt   DateTime?
  masteredAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  unit               Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  subtopics          Subtopic[]
  cards              Card[]
  studySessions      StudySession[]
  formulaEntries     FormulaEntry[]
  attemptResponses   AttemptResponse[]
  aiConversations    AiConversation[]
  lesson             TopicLesson?
  videos             TopicVideo[]
  mistakes           Mistake[]

  @@index([userId])
  @@index([unitId])
}

model Subtopic {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic               Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  learningObjectives  LearningObjective[]
  cards               Card[]

  @@index([userId])
  @@index([topicId])
}

model LearningObjective {
  id            String    @id @default(uuid())
  userId        String
  subtopicId    String
  text          String
  qcaaReference String?
  ragStatus     RagStatus @default(unrated)
  ragUpdatedAt  DateTime?
  ragHistory    Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subtopic          Subtopic           @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  cards             Card[]
  teachBackSessions TeachBackSession[]

  @@index([userId])
  @@index([subtopicId])
  @@index([ragStatus])
}

// ---------- spaced repetition ----------

model Card {
  id           String   @id @default(uuid())
  userId       String
  subjectId    String
  topicId      String
  subtopicId   String?
  objectiveId  String?
  cardType     CardType
  complexity   ComplexityBand?
  front        String
  back         String
  extra        String?
  /// JSON-encoded string[]. SQLite has no native array column, unlike the
  /// Postgres this schema used to target — encode/decode via
  /// lib/cards.ts's encodeTags/decodeTags rather than touching this raw.
  tags         String   @default("[]")
  isSuspended  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic       Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopic    Subtopic?           @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  objective   LearningObjective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  media       CardMedia[]
  reviews     Review[]
  scheduling  CardScheduling?
  mistakes    Mistake[]

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
}

model CardMedia {
  id          String        @id @default(uuid())
  userId      String
  cardId      String
  storagePath String
  altText     String?
  position    MediaPosition
  createdAt   DateTime      @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cardId])
}

model Review {
  id             String   @id @default(uuid())
  userId         String
  cardId         String
  reviewedAt     DateTime @default(now())
  quality        Int
  intervalBefore Float
  intervalAfter  Float
  easeBefore     Float
  easeAfter      Float
  timeTakenMs    Int?

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cardId])
}

model CardScheduling {
  id           String   @id @default(uuid())
  userId       String
  cardId       String   @unique
  dueDate      DateTime
  intervalDays Float    @default(0)
  easeFactor   Float    @default(2.5)
  repetitions  Int      @default(0)
  lapses       Int      @default(0)
  learningStep Int      @default(0)
  state        SrsState @default(new)
  updatedAt    DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueDate])
  @@index([state])
}

// ---------- study tracking ----------

model StudySession {
  id                 String      @id @default(uuid())
  userId             String
  subjectId          String
  topicId            String?
  startedAt          DateTime
  endedAt            DateTime?
  focusMinutes        Float       @default(0)
  breakMinutes        Float       @default(0)
  sessionType        SessionType
  notes              String?
  completedNaturally Boolean     @default(false)
  createdAt          DateTime    @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subjectId])
  @@index([startedAt])
}

model DailyPlan {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime
  generatedAt DateTime @default(now())
  planJson    Json
  wasFollowed Boolean?

  @@index([userId])
  @@unique([userId, date])
}

model WeeklyReview {
  id                  String   @id @default(uuid())
  userId              String
  weekStart           DateTime
  statsJson           Json
  aiSummary           String?
  aiRecommendations   String?
  createdAt           DateTime @default(now())

  @@index([userId])
  @@unique([userId, weekStart])
}

// ---------- content ----------

model FormulaEntry {
  id             String   @id @default(uuid())
  userId         String
  subjectId      String
  topicId        String?
  latex          String
  plainText      String
  description    String
  onFormulaSheet Boolean  @default(false)
  category       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subjectId])
}

model AssumedKnowledge {
  id        String   @id @default(uuid())
  userId    String
  subjectId String
  category  String
  prompt    String
  answer    String
  latex     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])
}

model Document {
  id            String      @id @default(uuid())
  userId        String
  subjectId     String
  filename      String
  storagePath   String
  docType       DocType
  notesFormat   NotesFormat?
  extractedText String?
  parsedAt      DateTime?
  createdAt     DateTime    @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])
}

// ---------- past papers ----------

model PastPaper {
  id                  String   @id @default(uuid())
  userId              String
  subjectId           String
  year                Int
  paperName           String
  questionPaperPath   String
  mcPaperPath         String?
  markingGuidePath    String?
  totalMarks          Int
  hasMarkingGuide     Boolean  @default(false)
  createdAt           DateTime @default(now())

  subject  Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  attempts PaperAttempt[]

  @@index([userId])
  @@index([subjectId])
}

model PaperAttempt {
  id                  String          @id @default(uuid())
  userId              String
  paperId             String
  startedAt           DateTime
  completedAt         DateTime?
  rawScore            Float?
  totalMarks          Int
  percentage          Float?
  timeTakenMinutes    Int?
  conditions          PaperConditions

  paper     PastPaper         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  responses AttemptResponse[]

  @@index([userId])
  @@index([paperId])
}

model AttemptResponse {
  id             String         @id @default(uuid())
  userId         String
  attemptId      String
  questionNumber String
  marksAvailable Float
  marksAwarded   Float?
  topicId        String?
  myAnswer       String?
  feedback       String?
  errorCategory  ErrorCategory?

  attempt PaperAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  topic   Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([attemptId])
  @@index([topicId])
}

// ---------- AI ----------

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  subjectId String?
  topicId   String?
  mode      AiMode
  startedAt DateTime @default(now())
  title     String?

  subject  Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic    Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  messages AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String   @id @default(uuid())
  userId         String
  conversationId String
  role           AiRole
  content        String
  tokensUsed     Int?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
}

/// A generated lesson for one topic, cached so it isn't regenerated on every
/// visit — each one is a long AI call and the content doesn't change unless
/// the syllabus does. `objectivesHash` is a digest of the topic's objective
/// text at generation time: if the curriculum is re-imported and the
/// objectives change, the hash stops matching and the lesson regenerates.
model TopicLesson {
  id             String   @id @default(uuid())
  userId         String
  topicId        String   @unique
  markdown       String
  objectivesHash String
  model          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A generated set of questions for one subject on one day.
///
/// The brief is that there is ALWAYS something to do for every subject, even
/// when the spaced-repetition queue happens to be empty. This is that: a fresh
/// set drawn from the active topic, recently mastered topics, and anything
/// rated red or amber.
///
/// questions/answers are JSON rather than rows because a set is written once,
/// read as a unit, and never queried across — normalising it would buy nothing
/// and cost a join on every load.
model DailyQuestionSet {
  id          String    @id @default(uuid())
  userId      String
  subjectId   String
  date        DateTime 
  questions   Json
  responses   Json      @default("[]")
  completedAt DateTime?
  /// Marks awarded / marks available, once marked. Null until then.
  scoreAwarded    Float?
  scoreAvailable  Float?
  createdAt   DateTime  @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId, date])
  @@index([userId])
}

model TeachBackSession {
  id               String    @id @default(uuid())
  userId           String
  objectiveId      String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  attempts         Int       @default(0)
  resolvedCorrectly Boolean?
  transcriptJson   Json      @default("[]")

  objective LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([objectiveId])
}

/// A YouTube tutorial video matched to one topic by keyword rules against the
/// imported video catalogue (see scripts/import-topic-videos.ts). A video can
/// legitimately match more than one topic, so this is a many-to-many via
/// plain rows rather than a one-to-one FK on the video itself — there is no
/// separate Video model, just topic-scoped rows carrying the youtubeId.
///
/// unique([topicId, youtubeId]) makes the import idempotent: re-running it
/// after the catalogue grows just createMany-skips rows already linked to
/// that topic instead of duplicating them.
/// A lost mark, kept until it stops costing marks.
///
/// Modelled on Examora's Mistake Folder, with one addition: `cardId`, so a
/// card failed in the reviewer can be logged straight from there. Theirs only
/// captures from self-marked exams or manual entry, which means the errors you
/// make while drilling — the ones you make most often — never get recorded.
///
/// `timesRepeated` is what separates a slip from a real weakness. Logging the
/// same mistake again bumps it rather than creating a second row, so the
/// REPEATED count means "you have now lost these marks more than once".
model Mistake {
  id            String          @id @default(uuid())
  userId        String
  subjectId     String
  topicId       String?
  cardId        String?
  category      MistakeCategory
  status        MistakeStatus   @default(new)
  whatWentWrong String
  whyItHappened String?
  fixAction     String?
  source        String?
  marksLost     Int?
  timesRepeated Int             @default(1)
  lastSeenAt    DateTime        @default(now())
  nextReviewAt  DateTime?
  masteredAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  card    Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subjectId])
  @@index([status])
  @@index([nextReviewAt])
}

model TopicVideo {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  youtubeId String
  title     String
  order     Int
  createdAt DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, youtubeId])
  @@index([userId])
  @@index([topicId])
}

// ---------- calendar ----------

model TimetableBlock {
  id         String   @id @default(uuid())
  userId     String
  dayOfWeek  Int
  periodName String
  // Nullable: a block is either a subject class OR a personal-routine
  // block (Gym, Study Hall, UGC Block, meals, wind-down...) described by
  // `label` instead. Exactly one of subjectId/label should be set —
  // enforced in the server action, not the DB, since Postgres check
  // constraints referencing two nullable columns add friction Prisma
  // migrate diff doesn't handle cleanly.
  subjectId  String?
  label      String?
  startTime  String
  endTime    String
  room       String?

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CalendarEvent {
  id           String   @id @default(uuid())
  userId       String
  googleEventId String  @unique
  title        String
  start        DateTime
  end          DateTime
  isStudyBlock Boolean  @default(false)
  subjectId    String?

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}
